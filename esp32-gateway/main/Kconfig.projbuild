menu "Example Configuration"

    config WIFI_SSID
        string "WiFi SSID"
        default "myssid"
        help
            Access point the gateway uses to reach MySQL. ESP-NOW uses this AP's channel.

    config WIFI_PASSWORD
        string "WiFi password"
        default "mypassword"

    config WIFI_MAX_RETRY
        int "WiFi connect retries"
        default 10
        range 1 100

    config MYSQL_HOST
        string "MySQL host"
        default "192.168.1.10"

    config MYSQL_PORT
        int "MySQL port"
        default 3306
        range 1 65535

    config MYSQL_USER
        string "MySQL user"
        default "savi"

    config MYSQL_PASSWORD
        string "MySQL password"
        default "savi"

    config MYSQL_DATABASE
        string "MySQL database"
        default "savi"

    config ESPNOW_CHANNEL
        int "ESP-NOW channel (informational)"
        default 1
        range 0 14
        help
            The live channel is the WiFi AP channel. Set the C6 node to that same channel.

endmenu
