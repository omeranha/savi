menu "Gateway Configuration"

    config WIFI_SSID
        string "WiFi SSID"
        default "myssid"
        help
            Access point the gateway uses to reach the MQTT broker. ESP-NOW uses this AP's channel.

    config WIFI_PASSWORD
        string "WiFi password"
        default "mypassword"

    config WIFI_MAX_RETRY
        int "WiFi connect retries before backing off"
        default 10
        range 1 100

    config MQTT_BROKER_URI
        string "MQTT broker URI"
        default "mqtt://broker.example.com"
        help
            URI of the MQTT broker that forwards SAVI messages to the backend.

    config MQTT_USERNAME
        string "MQTT username"
        default ""
        help
            Leave empty if the broker does not require a username.

    config MQTT_PASSWORD
        string "MQTT password"
        default ""
        help
            Leave empty if the broker does not require a password.

    config MQTT_CERT_BUNDLE
        bool
        default y
        select MBEDTLS_CERTIFICATE_BUNDLE

    config SAVI_GATEWAY_LOCAL
        string "Where this gateway is installed"
        default "unset"
        help
            Free text written to the gateways.local column, so the dashboard can say which
            gateway a bracelet is near. Something like "Ward 2" or "Reception".

    config SAVI_UTC_OFFSET_MINUTES
        int "UTC offset in minutes for atualizado_em"
        default -180
        range -720 840
        help
            Single source of truth for the timestamps published to Supabase: it sets both the TZ
            variable and the ISO-8601 offset suffix. -180 is UTC-03:00 (Brasilia, no DST).

endmenu
