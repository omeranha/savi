menu "Example Configuration"

    config WIFI_SSID
        string "WiFi SSID"
        default "myssid"
        help
            Access point the gateway uses to reach Supabase. ESP-NOW uses this AP's channel.

    config WIFI_PASSWORD
        string "WiFi password"
        default "mypassword"

    config WIFI_MAX_RETRY
        int "WiFi connect retries"
        default 10
        range 1 100

    config SUPABASE_URL
        string "Supabase project URL"
        default "https://your-project.supabase.co"

    config SUPABASE_ANON_KEY
        string "Supabase anon/public key"
        default ""
        help
            Use the project's anon/public key, never its service_role key.

    config SUPABASE_CERT_BUNDLE
        bool
        default y
        select MBEDTLS_CERTIFICATE_BUNDLE

    config ESPNOW_CHANNEL
        int "ESP-NOW channel (informational)"
        default 1
        range 0 14
        help
            The live channel is the WiFi AP channel. Set the C6 node to that same channel.

endmenu
